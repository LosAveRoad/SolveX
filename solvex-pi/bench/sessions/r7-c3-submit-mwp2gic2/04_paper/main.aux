\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Pipeline schematic and deliverable map. The shared preprocessing layer (\texttt  {prep\_data.py}, all checks passing) produces three tables --- \texttt  {contestants.csv} (421 rows), \texttt  {weekly\_scores.csv} (2{,}777 danced celebrity-weeks), and \texttt  {week\_panel.csv} (335 season-weeks). Model 1 consumes the judge scores plus the elimination record and produces the single shared latent quantity $\hat  \phi $ with its uncertainty bands; Models 2 and 3 consume $\hat  \phi $ \emph  {without refitting it}, guaranteeing one consistent latent-vote story throughout the report.}}{5}{table.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:deliverablemap}{{1}{5}{Pipeline schematic and deliverable map. The shared preprocessing layer (\texttt {prep\_data.py}, all checks passing) produces three tables --- \texttt {contestants.csv} (421 rows), \texttt {weekly\_scores.csv} (2{,}777 danced celebrity-weeks), and \texttt {week\_panel.csv} (335 season-weeks). Model 1 consumes the judge scores plus the elimination record and produces the single shared latent quantity $\hat \phi $ with its uncertainty bands; Models 2 and 3 consume $\hat \phi $ \emph {without refitting it}, guaranteeing one consistent latent-vote story throughout the report}{table.caption.2}{}}
