\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Estimated weekly fan-vote share $\hat  \phi $ (solid, with 90\% bands) versus judge percentile (dashed) for Bobby Bones (S27), Jerry Rice (S2), Bristol Palin (S11), and Joey Graziadei (S33). Vertical dotted lines mark each contestant's exit (or the finale). Bones and Palin ride a belief-frailty fusion to sustained $\hat  \phi $ far above their judge percentile; Graziadei tracks judges closely, evidence the estimator does not create spurious conflict.}}{9}{figure.caption.5}\protected@file@percent }
\newlabel{fig:m1iconic}{{1}{9}{Estimated weekly fan-vote share $\hat \phi $ (solid, with 90\% bands) versus judge percentile (dashed) for Bobby Bones (S27), Jerry Rice (S2), Bristol Palin (S11), and Joey Graziadei (S33). Vertical dotted lines mark each contestant's exit (or the finale). Bones and Palin ride a belief-frailty fusion to sustained $\hat \phi $ far above their judge percentile; Graziadei tracks judges closely, evidence the estimator does not create spurious conflict}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Judge-panel conflict diagnostics per season-week: (a) panel disagreement $(1-q_w)$ and (b) fused Dempster conflict $K_w$. The $K$ panel is dominated by frame size (e.g.\ 13-couple premiere casts vs.\ 3-couple finals), demonstrating that raw Dempster conflict in large singleton frames measures cast size more than disagreement; this is why certainty layers use the panel discount instead.}}{9}{figure.caption.6}\protected@file@percent }
\newlabel{fig:m1conflict}{{2}{9}{Judge-panel conflict diagnostics per season-week: (a) panel disagreement $(1-q_w)$ and (b) fused Dempster conflict $K_w$. The $K$ panel is dominated by frame size (e.g.\ 13-couple premiere casts vs.\ 3-couple finals), demonstrating that raw Dempster conflict in large singleton frames measures cast size more than disagreement; this is why certainty layers use the panel discount instead}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Median 90\%-band width (share points) by week-in-season, stratified by judge-disagreement tertile. Intervals widen from $\approx $0.085 in week 1 to $\approx $0.114 in week 6+; contentious weeks (upper tertile of panel disagreement) are wider still. Uncertainty is therefore contestant- and week-specific, not a fixed constant.}}{10}{figure.caption.7}\protected@file@percent }
\newlabel{fig:m1certainty}{{3}{10}{Median 90\%-band width (share points) by week-in-season, stratified by judge-disagreement tertile. Intervals widen from $\approx $0.085 in week 1 to $\approx $0.114 in week 6+; contentious weeks (upper tertile of panel disagreement) are wider still. Uncertainty is therefore contestant- and week-specific, not a fixed constant}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Reliability of Monte-Carlo $P(\text  {eliminated})$: decile means of predicted vs.\ observed probability track the diagonal (mean predicted 0.109 vs.\ observed event rate 0.108; AUC 0.959; Brier 0.047). Inset: distribution of predicted probabilities --- properly concentrated near zero for safe couples.}}{10}{figure.caption.8}\protected@file@percent }
\newlabel{fig:m1calibration}{{4}{10}{Reliability of Monte-Carlo $P(\text {eliminated})$: decile means of predicted vs.\^^Mobserved probability track the diagonal (mean predicted 0.109 vs.\ observed event rate 0.108; AUC 0.959; Brier 0.047). Inset: distribution of predicted probabilities --- properly concentrated near zero for safe couples}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Couple-level latent fan pressure $\hat  u$ versus mean judge percentile, with OLS fit. The near-flat slope ($\mathrm  {corr} = +0.113$) confirms the frailty captures fan support \emph  {unexplained} by judges; iconic fan favorites (Bobby Bones, Bristol Palin, Jerry Rice) sit in the favorable-frailty half-plane despite modest judge percentiles.}}{11}{figure.caption.9}\protected@file@percent }
\newlabel{fig:m1frailty}{{5}{11}{Couple-level latent fan pressure $\hat u$ versus mean judge percentile, with OLS fit. The near-flat slope ($\mathrm {corr} = +0.113$) confirms the frailty captures fan support \emph {unexplained} by judges; iconic fan favorites (Bobby Bones, Bristol Palin, Jerry Rice) sit in the favorable-frailty half-plane despite modest judge percentiles}{figure.caption.9}{}}
