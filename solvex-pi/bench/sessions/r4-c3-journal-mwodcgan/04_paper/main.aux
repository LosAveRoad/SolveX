\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Model 1 --- 90\%-interval half-width of inferred fan-share estimates vs.\ week number within the season (percentage rule; band shows the IQR across seasons and contestants). Certainty improves sharply toward the finale: fewer survivors and wider judge spread shrink the feasible set. Certainty is therefore a structural property of the week, not a constant.}}{10}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:m1cert}{{1}{10}{Model 1 --- 90\%-interval half-width of inferred fan-share estimates vs.\^^Mweek number within the season (percentage rule; band shows the IQR across seasons and contestants). Certainty improves sharply toward the finale: fewer survivors and wider judge spread shrink the feasible set. Certainty is therefore a structural property of the week, not a constant}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Model 1 --- heatmap of mean judge--fan divergence ($\bar  {G} = F^* - J$) across the 34 seasons (rows) and competition weeks (columns), \textbf  {percentage rule only}. Because the rank-rule rows lack a comparable judge-share definition under the two-rule normalization used, no rank-rule panel is shown and no ``season-28 rank-rule shift'' is claimed from this figure (an earlier draft caption did so; corrected). More saturated cells are weeks where fan support deviated most from judge share --- candidate controversy weeks.}}{11}{figure.caption.3}\protected@file@percent }
\newlabel{fig:m1gap}{{2}{11}{Model 1 --- heatmap of mean judge--fan divergence ($\bar {G} = F^* - J$) across the 34 seasons (rows) and competition weeks (columns), \textbf {percentage rule only}. Because the rank-rule rows lack a comparable judge-share definition under the two-rule normalization used, no rank-rule panel is shown and no ``season-28 rank-rule shift'' is claimed from this figure (an earlier draft caption did so; corrected). More saturated cells are weeks where fan support deviated most from judge share --- candidate controversy weeks}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Model 1 --- the four documented controversies. Each panel shows judge share (squares/markers) vs.\ inferred fan share (points with 90\% bands) across the celebrity's competing weeks, under both rules where applicable. In all four cases the inferred fan share sits above the judge share for most of the run --- the signature of a fan-driven run: Jerry Rice (S2, runner-up), Billy Ray Cyrus (S4, 5th), Bristol Palin (S11, 3rd), Bobby Bones (S27, winner).}}{12}{figure.caption.4}\protected@file@percent }
\newlabel{fig:m1cases}{{3}{12}{Model 1 --- the four documented controversies. Each panel shows judge share (squares/markers) vs.\ inferred fan share (points with 90\% bands) across the celebrity's competing weeks, under both rules where applicable. In all four cases the inferred fan share sits above the judge share for most of the run --- the signature of a fan-driven run: Jerry Rice (S2, runner-up), Billy Ray Cyrus (S4, 5th), Bristol Palin (S11, 3rd), Bobby Bones (S27, winner)}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Model 1 --- calibration diagnostics. \textbf  {Left}: exact-LP $\gamma _{\max }$ distribution per week with each week's theoretical bound $1/n_s$ overlaid (all 264 points satisfy the bound; max 0.197 at four-survivor weeks as expected). \textbf  {Middle}: band half-width vs.\ $\gamma _{\max }$, Pearson $r = 0.13$ --- only a weak association, correcting the earlier over-claim. \textbf  {Right}: reproduction-rate histograms for the calibrated model vs.\ the uniform-Dirichlet null (mean 0.74 vs.\ 0.23; 253/264 weeks at single-week $p<0.01$).}}{12}{figure.caption.5}\protected@file@percent }
\newlabel{fig:m1cal}{{4}{12}{Model 1 --- calibration diagnostics. \textbf {Left}: exact-LP $\gamma _{\max }$ distribution per week with each week's theoretical bound $1/n_s$ overlaid (all 264 points satisfy the bound; max 0.197 at four-survivor weeks as expected). \textbf {Middle}: band half-width vs.\ $\gamma _{\max }$, Pearson $r = 0.13$ --- only a weak association, correcting the earlier over-claim. \textbf {Right}: reproduction-rate histograms for the calibrated model vs.\ the uniform-Dirichlet null (mean 0.74 vs.\^^M0.23; 253/264 weeks at single-week $p<0.01$)}{figure.caption.5}{}}
