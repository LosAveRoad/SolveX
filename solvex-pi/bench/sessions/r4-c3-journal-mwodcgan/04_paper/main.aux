\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}Figures}{17}{subsection.3.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Model 2 --- winner flip probability by season (RANK vs PCT replay, $K=150$ replicates). The average is $0.489$; season 21 (Bindi Irwin) and season 13 are the extremes. No season is immune: even the least sensitive season has a $\ge 0.24$ probability of a different winner under the alternate rule, and top-3 flips exceed 0.75 in 17/34 seasons.}}{17}{figure.caption.8}\protected@file@percent }
\newlabel{fig:m2flip}{{5}{17}{Model 2 --- winner flip probability by season (RANK vs PCT replay, $K=150$ replicates). The average is $0.489$; season 21 (Bindi Irwin) and season 13 are the extremes. No season is immune: even the least sensitive season has a $\ge 0.24$ probability of a different winner under the alternate rule, and top-3 flips exceed 0.75 in 17/34 seasons}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Model 2 --- counterfactual final placements of the four controversy celebrities under each replay variant (median over replicates).Jerry Rice and Bristol Palin move dramatically between rules; Billy Ray Cyrus is rule-robust; Bobby Bones wins under most variants with material probability.}}{18}{figure.caption.9}\protected@file@percent }
\newlabel{fig:m2controversy}{{6}{18}{Model 2 --- counterfactual final placements of the four controversy celebrities under each replay variant (median over replicates).Jerry Rice and Bristol Palin move dramatically between rules; Billy Ray Cyrus is rule-robust; Bobby Bones wins under most variants with material probability}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Model 2 --- $\alpha $ sensitivity for selected seasons (1, 2, 4, 11, 27, 28, 34): agreement of the replayed elimination sequence with a judge-only elimination sequence as the judge weight $\alpha $ sweeps $0 \to 1$. Agreement rises with $\alpha $ in most seasons (e.g., season 1: $0.453 \to 0.713$), but \emph  {declines} in seasons 2 and 27 for $\alpha > 0.5$ --- the two controversy seasons --- where a judge-heavy rule would have eliminated fan-popular couples (Rice, Bones) contrary to the recorded history that fans sustained them.}}{18}{figure.caption.10}\protected@file@percent }
\newlabel{fig:m2alpha}{{7}{18}{Model 2 --- $\alpha $ sensitivity for selected seasons (1, 2, 4, 11, 27, 28, 34): agreement of the replayed elimination sequence with a judge-only elimination sequence as the judge weight $\alpha $ sweeps $0 \to 1$. Agreement rises with $\alpha $ in most seasons (e.g., season 1: $0.453 \to 0.713$), but \emph {declines} in seasons 2 and 27 for $\alpha > 0.5$ --- the two controversy seasons --- where a judge-heavy rule would have eliminated fan-popular couples (Rice, Bones) contrary to the recorded history that fans sustained them}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Model 2 --- convergence of flip-probability estimates with replicate count. Estimates are stable within Monte-Carlo error well before the full 150 replicates, supporting the stability of the headline numbers in Table~\ref {tab:replay}.}}{19}{figure.caption.11}\protected@file@percent }
\newlabel{fig:m2conv}{{8}{19}{Model 2 --- convergence of flip-probability estimates with replicate count. Estimates are stable within Monte-Carlo error well before the full 150 replicates, supporting the stability of the headline numbers in Table~\ref {tab:replay}}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Model 2 --- divergence map of judge-share vs fan-share percentiles across couple-weeks, colored by (survival) status. The map shows that judge-fan disagreement is broadly distributed rather than confined to late-season weeks or particular eras, which is why both rules occasionally produce divergent outcomes in every season.}}{20}{figure.caption.12}\protected@file@percent }
\newlabel{fig:m2map}{{9}{20}{Model 2 --- divergence map of judge-share vs fan-share percentiles across couple-weeks, colored by (survival) status. The map shows that judge-fan disagreement is broadly distributed rather than confined to late-season weeks or particular eras, which is why both rules occasionally produce divergent outcomes in every season}{figure.caption.12}{}}
