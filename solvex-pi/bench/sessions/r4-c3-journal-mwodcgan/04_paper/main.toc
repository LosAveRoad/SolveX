\contentsline {section}{\numberline {5}Results and Analysis Across Models}{26}{section.5}%
\contentsline {subsection}{\numberline {5.1}Integrated Findings}{26}{subsection.5.1}%
\contentsline {paragraph}{1. Fan votes consistent with every elimination exist, and are not extreme.}{26}{section*.17}%
\contentsline {paragraph}{2. Certainty is structural and non-uniform.}{26}{section*.18}%
\contentsline {paragraph}{3. Rule choice matters enormously, but neither rule systematically favors fans.}{26}{section*.19}%
\contentsline {paragraph}{4. The judges-save mechanism is a modest but real judge-side corrective.}{26}{section*.20}%
\contentsline {paragraph}{5. Celebrity demographics barely move either audience.}{26}{section*.21}%
