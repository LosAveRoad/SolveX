\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Posterior fan-vote share pathways (mean, 95\% credible band) across competition weeks for the four controversy cases --- Jerry Rice (S2), Billy Ray Cyrus (S4), Bristol Palin (S11), and Bobby Bones (S27) --- with within-week judge ranks beneath. Bristol Palin's support climbs from 0.088 to 0.288 while her judge rank stays 3rd--8th; Bobby Bones's climbs toward 0.44-equivalent support late in season 27 despite bottom-half judge ranks. Bands are widest in early weeks (weak constraints) and narrowest near the finale.}}{7}{figure.caption.11}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:fanpathways}{{1}{7}{Posterior fan-vote share pathways (mean, 95\% credible band) across competition weeks for the four controversy cases --- Jerry Rice (S2), Billy Ray Cyrus (S4), Bristol Palin (S11), and Bobby Bones (S27) --- with within-week judge ranks beneath. Bristol Palin's support climbs from 0.088 to 0.288 while her judge rank stays 3rd--8th; Bobby Bones's climbs toward 0.44-equivalent support late in season 27 despite bottom-half judge ranks. Bands are widest in early weeks (weak constraints) and narrowest near the finale}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Certainty profile by week index. Mean posterior coefficient of variation (CV) and 95\% credible-interval width of weekly fan shares, split by combination rule (rank rule vs.\ percentage rule). Early-week shares are prior-dominated and wide; late-week shares are pinned down by accumulated elimination constraints. The mean CI width at baseline $\sigma = 0.35$ is 0.145, versus 0.085 at $\sigma = 0.20$ and 0.312 at $\sigma = 0.75$.}}{7}{figure.caption.12}\protected@file@percent }
\newlabel{fig:uncweek}{{2}{7}{Certainty profile by week index. Mean posterior coefficient of variation (CV) and 95\% credible-interval width of weekly fan shares, split by combination rule (rank rule vs.\ percentage rule). Early-week shares are prior-dominated and wide; late-week shares are pinned down by accumulated elimination constraints. The mean CI width at baseline $\sigma = 0.35$ is 0.145, versus 0.085 at $\sigma = 0.20$ and 0.312 at $\sigma = 0.75$}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Hold-out calibration: distribution of the prior-only replay probability of the observed eliminated couple over the 232 elimination-weeks (mean 0.267, median 0.235, max 0.875; 10.8\% of weeks $\ge 0.5$). The prior alone beats the uniform $1/n \approx 0.10$--$0.16$ baseline by $2\times $--$2.5\times $, confirming that fans weakly track judge quality but with substantial popularity noise, and that eliminations carry genuine identifying information beyond the prior.}}{8}{figure.caption.13}\protected@file@percent }
\newlabel{fig:holdout}{{3}{8}{Hold-out calibration: distribution of the prior-only replay probability of the observed eliminated couple over the 232 elimination-weeks (mean 0.267, median 0.235, max 0.875; 10.8\% of weeks $\ge 0.5$). The prior alone beats the uniform $1/n \approx 0.10$--$0.16$ baseline by $2\times $--$2.5\times $, confirming that fans weakly track judge quality but with substantial popularity noise, and that eliminations carry genuine identifying information beyond the prior}{figure.caption.13}{}}
