\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Mean normalized survival entropy by rule. PROPOSED is the most exciting rule (0.918); JUDGE\_SAVE the least (0.612), the mechanical result of the judges' tie-break collapsing the bottom-two pool early.}}{12}{figure.caption.22}\protected@file@percent }
