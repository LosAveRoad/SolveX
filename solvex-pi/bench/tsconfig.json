{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": false, "skipLibCheck": true, "allowImportingTsExtensions": true, "noEmit": true,
    "baseUrl": "..",
    "paths": {
      "@solvex/core": ["packages/core/src/index.ts"],
      "@solvex/core/*": ["packages/core/src/*"],
      "@solvex/pi-runtime": ["packages/pi-runtime/src/index.ts"],
      "@solvex/pi-runtime/*": ["packages/pi-runtime/src/*"]
    }
  }
}
