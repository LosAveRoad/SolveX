# 复制为 .env 后填入真实值；.env 不会进版本库。
# 配置文件里的 apiKey 只能写成 $VAR / ${VAR}，例如 "$DEEPSEEK_API_KEY"。
# 可用 SOLVEX_ENV_FILE=/path/to/other.env 覆盖默认位置。

DEEPSEEK_API_KEY=

